function planRows_() {
  const rows = [];
  PLAN_WEEKS_.forEach(w => {
    const end = w.end || addDays_(w.start, 6);
    w.tasks.forEach(t => rows.push(['T-' + pad_(rows.length + 1), w.week, w.start, end, t[0], t[1], t[2], 'todo', '', '']));
  });
  return rows;
}

function seedRows_(name) {
  switch (name) {
    case 'AI_GUIDE': return GUIDE_;
    case 'Plan': return planRows_();
    case 'Goals': return GOALS_.map((g, i) => ['G-' + pad_(i + 1), g[0], g[1], g[2], 'todo', '']);
    case 'Routine': return ROUTINE_;
    case 'Cards': return CARDS_.map((c, i) => ['C-' + pad_(i + 1), c[0], c[1], c[2], 0, c[3], '', 0, 'active', 'starter']);
    case 'Config': return CONFIG_;
    default: return [];
  }
}
